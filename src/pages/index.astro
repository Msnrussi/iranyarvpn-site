---
import Layout from '../layouts/Layout.astro';
---
<Layout title="ایران‌یار VPN | آی‌پی ایران برای ایرانیان خارج از کشور">
  <main>

    <!-- Hero -->
    <section class="hero">
      <div class="hero-bg">
        <div class="orb orb1"></div>
        <div class="orb orb2"></div>
        <div class="orb orb3"></div>
      </div>
      <nav class="navbar glass">
        <div class="logo">🇮🇷 ایران‌یار VPN</div>
        <a href="#pricing" class="btn-nav">خرید اشتراک</a>
      </nav>
      <div class="hero-content fade-in">
        <h1>آی‌پی ایران<br/><span class="highlight">هر جای دنیا</span></h1>
        <p class="hero-sub">به همراه‌بانک، فیلیمو، شاد و تمام سایت‌های ایرانی<br/>از خارج از کشور دسترسی داشته باش</p>
        <div class="hero-btns">
          <a href="#pricing" class="btn-primary">خرید اشتراک</a>
          <a href="#features" class="btn-ghost">امکانات</a>
        </div>
        <div class="stats">
          <div class="stat"><span class="stat-num">۹۹٪</span><span class="stat-label">آپتایم</span></div>
          <div class="stat-divider"></div>
          <div class="stat"><span class="stat-num">۲۴/۷</span><span class="stat-label">پشتیبانی</span></div>
          <div class="stat-divider"></div>
          <div class="stat"><span class="stat-num">سریع</span><span class="stat-label">سرعت بالا</span></div>
        </div>
      </div>
      <div class="scroll-indicator">
        <div class="scroll-dot"></div>
      </div>
    </section>

    <!-- Features -->
    <section class="features" id="features">
      <div class="container">
        <h2 class="section-title reveal">چرا ایران‌یار؟</h2>
        <div class="features-grid">
          <div class="feature-card glass reveal">
            <div class="feature-icon">🏦</div>
            <h3>همراه‌بانک و اینترنت‌بانک</h3>
            <p>به تمام بانک‌های ایرانی، پرداخت‌های آنلاین و سرویس‌های مالی دسترسی داشته باش</p>
          </div>
          <div class="feature-card glass reveal">
            <div class="feature-icon">🎬</div>
            <h3>فیلم و سریال ایرانی</h3>
            <p>فیلیمو، نماوا، آپارات و تمام پلتفرم‌های ویدیویی ایران بدون محدودیت</p>
          </div>
          <div class="feature-card glass reveal">
            <div class="feature-icon">🎓</div>
            <h3>آموزش و دانشگاه</h3>
            <p>شاد، دانشگاه‌ها، موسسات آموزشی و سامانه‌های اداری ایران</p>
          </div>
          <div class="feature-card glass reveal">
            <div class="feature-icon">⚡</div>
            <h3>سرعت بالا</h3>
            <p>سرورهای اختصاصی با پهنای باند نامحدود و پینگ پایین</p>
          </div>
          <div class="feature-card glass reveal">
            <div class="feature-icon">🔒</div>
            <h3>آی‌پی اختصاصی</h3>
            <p>آی‌پی ثابت و اختصاصی برای هر کاربر جداگانه</p>
          </div>
          <div class="feature-card glass reveal">
            <div class="feature-icon">📱</div>
            <h3>همه دستگاه‌ها</h3>
            <p>موبایل، تبلت، لپ‌تاپ — روی همه سیستم‌ها کار می‌کند</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section class="pricing" id="pricing">
      <div class="container">
        <h2 class="section-title reveal">انتخاب پلن</h2>
        <p class="section-sub reveal">پلن مناسب خودت رو انتخاب کن</p>
        <div class="pricing-grid">
          <div class="pricing-card glass reveal">
            <div class="plan-name">ماهانه</div>
            <div class="plan-price">
              <span class="price-amount">---</span>
              <span class="price-unit">/ ماه</span>
            </div>
            <ul class="plan-features">
              <li>✅ آی‌پی اختصاصی ایران</li>
              <li>✅ پهنای باند نامحدود</li>
              <li>✅ پشتیبانی ۲۴/۷</li>
              <li>✅ تمام بانک‌های ایرانی</li>
            </ul>
            <a href="#" class="btn-plan">خرید ماهانه</a>
          </div>
          <div class="pricing-card glass reveal featured">
            <div class="plan-badge">پرفروش‌ترین</div>
            <div class="plan-name">سه‌ماهه</div>
            <div class="plan-price">
              <span class="price-amount">---</span>
              <span class="price-unit">/ سه ماه</span>
            </div>
            <ul class="plan-features">
              <li>✅ آی‌پی اختصاصی ایران</li>
              <li>✅ پهنای باند نامحدود</li>
              <li>✅ پشتیبانی ۲۴/۷</li>
              <li>✅ تمام بانک‌های ایرانی</li>
              <li>✅ ۱۵٪ تخفیف نسبت به ماهانه</li>
            </ul>
            <a href="#" class="btn-plan featured-btn">خرید سه‌ماهه</a>
          </div>
          <div class="pricing-card glass reveal">
            <div class="plan-name">سالانه</div>
            <div class="plan-price">
              <span class="price-amount">---</span>
              <span class="price-unit">/ سال</span>
            </div>
            <ul class="plan-features">
              <li>✅ آی‌پی اختصاصی ایران</li>
              <li>✅ پهنای باند نامحدود</li>
              <li>✅ پشتیبانی ۲۴/۷</li>
              <li>✅ تمام بانک‌های ایرانی</li>
              <li>✅ ۳۰٪ تخفیف نسبت به ماهانه</li>
              <li>✅ اولویت پشتیبانی</li>
            </ul>
            <a href="#" class="btn-plan">خرید سالانه</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq" id="faq">
      <div class="container">
        <h2 class="section-title reveal">سوالات متداول</h2>
        <div class="faq-list">
          <div class="faq-item glass reveal">
            <button class="faq-q">چطور متصل بشم؟</button>
            <div class="faq-a">بعد از خرید، راهنمای اتصال برات ارسال می‌شه. روی موبایل و کامپیوتر به راحتی نصب می‌شه.</div>
          </div>
          <div class="faq-item glass reveal">
            <button class="faq-q">آی‌پی ثابته یا متغیر؟</button>
            <div class="faq-a">آی‌پی اختصاصی و ثابت برای هر کاربر جداگانه است. یعنی آی‌پی شما با کس دیگه‌ای مشترک نیست.</div>
          </div>
          <div class="faq-item glass reveal">
            <button class="faq-q">محدودیت حجم داره؟</button>
            <div class="faq-a">خیر، پهنای باند کاملاً نامحدود است.</div>
          </div>
          <div class="faq-item glass reveal">
            <button class="faq-q">پشتیبانی چطوره؟</button>
            <div class="faq-a">از طریق تلگرام و واتساپ ۲۴ ساعته در خدمتتیم.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="contact" id="contact">
      <div class="container">
        <h2 class="section-title reveal">تماس با ما</h2>
        <div class="contact-cards">
          <a href="https://t.me/iranyarvpn" class="contact-card glass reveal">
            <div class="contact-icon">✈️</div>
            <div class="contact-label">تلگرام</div>
            <div class="contact-val">@iranyarvpn</div>
          </a>
          <a href="https://wa.me/00000000000" class="contact-card glass reveal">
            <div class="contact-icon">💬</div>
            <div class="contact-label">واتساپ</div>
            <div class="contact-val">پیام بده</div>
          </a>
        </div>
      </div>
    </section>

    <footer class="footer">
      <p>© ۱۴۰۴ ایران‌یار VPN — تمام حقوق محفوظ است</p>
    </footer>

  </main>
</Layout>

<style>
  :root {
    --green: #2d7a3a;
    --green-light: #3fa050;
    --green-glow: rgba(45,122,58,0.25);
    --red: #c0392b;
    --red-light: #e74c3c;
    --white: #ffffff;
    --bg: #0a0f0a;
    --bg2: #0f180f;
    --glass: rgba(255,255,255,0.06);
    --glass-border: rgba(255,255,255,0.12);
    --text: #e8f5e9;
    --text-muted: #a5c8a8;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Vazirmatn', 'Tahoma', sans-serif;
    direction: rtl;
    background: var(--bg);
    color: var(--text);
    overflow-x: hidden;
  }

  .glass {
    background: var(--glass);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--glass-border);
  }

  /* Hero */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 20% 50%, rgba(45,122,58,0.15) 0%, transparent 60%),
                radial-gradient(ellipse at 80% 20%, rgba(192,57,43,0.1) 0%, transparent 50%),
                linear-gradient(180deg, #0a0f0a 0%, #0f1a0f 100%);
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    animation: float 8s ease-in-out infinite;
  }
  .orb1 { width: 400px; height: 400px; background: rgba(45,122,58,0.2); top: -100px; right: -100px; animation-delay: 0s; }
  .orb2 { width: 300px; height: 300px; background: rgba(192,57,43,0.15); bottom: 100px; left: -50px; animation-delay: 3s; }
  .orb3 { width: 200px; height: 200px; background: rgba(45,122,58,0.1); top: 50%; left: 50%; animation-delay: 6s; }

  @keyframes float {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-30px) scale(1.05); }
  }

  .navbar {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    margin: 1rem;
    border-radius: 16px;
  }

  .logo { font-size: 1.2rem; font-weight: bold; color: var(--white); }

  .btn-nav {
    background: var(--green);
    color: white;
    padding: 0.5rem 1.5rem;
    border-radius: 50px;
    text-decoration: none;
    font-size: 0.9rem;
    transition: background 0.2s;
  }
  .btn-nav:hover { background: var(--green-light); }

  .hero-content {
    position: relative;
    z-index: 5;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 2rem;
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: bold;
    line-height: 1.3;
    margin-bottom: 1.5rem;
    color: var(--white);
  }

  .highlight {
    background: linear-gradient(90deg, var(--green-light), #a8e6b0);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 2;
    margin-bottom: 2.5rem;
    max-width: 600px;
  }

  .hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-bottom: 3rem; }

  .btn-primary {
    background: linear-gradient(135deg, var(--green), var(--green-light));
    color: white;
    padding: 0.85rem 2.5rem;
    border-radius: 50px;
    text-decoration: none;
    font-size: 1rem;
    font-weight: bold;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 20px rgba(45,122,58,0.4);
  }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(45,122,58,0.5); }

  .btn-ghost {
    background: transparent;
    color: var(--text);
    padding: 0.85rem 2.5rem;
    border-radius: 50px;
    text-decoration: none;
    font-size: 1rem;
    border: 1px solid var(--glass-border);
    transition: background 0.2s;
  }
  .btn-ghost:hover { background: var(--glass); }

  .stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    background: var(--glass);
    backdrop-filter: blur(16px);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 1rem 2rem;
  }

  .stat { text-align: center; }
  .stat-num { display: block; font-size: 1.5rem; font-weight: bold; color: var(--green-light); }
  .stat-label { font-size: 0.8rem; color: var(--text-muted); }
  .stat-divider { width: 1px; height: 40px; background: var(--glass-border); }

  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
  }
  .scroll-dot {
    width: 6px;
    height: 6px;
    background: var(--green-light);
    border-radius: 50%;
    animation: scrollBounce 2s ease-in-out infinite;
  }
  @keyframes scrollBounce {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(12px); opacity: 0.4; }
  }

  /* Sections */
  section { padding: 5rem 0; }
  .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }

  .section-title {
    text-align: center;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    color: var(--white);
    margin-bottom: 0.75rem;
  }
  .section-sub {
    text-align: center;
    color: var(--text-muted);
    margin-bottom: 3rem;
  }

  /* Features */
  .features { background: linear-gradient(180deg, var(--bg) 0%, var(--bg2) 100%); }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .feature-card {
    border-radius: 16px;
    padding: 1.75rem;
    transition: transform 0.3s;
  }
  .feature-card:hover { transform: translateY(-4px); }
  .feature-icon { font-size: 2rem; margin-bottom: 1rem; }
  .feature-card h3 { color: var(--white); margin-bottom: 0.5rem; font-size: 1.05rem; }
  .feature-card p { color: var(--text-muted); font-size: 0.9rem; line-height: 1.8; }

  /* Pricing */
  .pricing { background: var(--bg2); }
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .pricing-card {
    border-radius: 20px;
    padding: 2rem;
    position: relative;
    transition: transform 0.3s;
    text-align: center;
  }
  .pricing-card:hover { transform: translateY(-4px); }
  .pricing-card.featured {
    border-color: var(--green);
    box-shadow: 0 0 40px rgba(45,122,58,0.2);
  }

  .plan-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(90deg, var(--green), var(--green-light));
    color: white;
    font-size: 0.75rem;
    padding: 4px 16px;
    border-radius: 50px;
    white-space: nowrap;
  }

  .plan-name { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem; }
  .plan-price { margin-bottom: 1.5rem; }
  .price-amount { font-size: 2.5rem; font-weight: bold; color: var(--white); }
  .price-unit { font-size: 0.9rem; color: var(--text-muted); }

  .plan-features {
    list-style: none;
    text-align: right;
    margin-bottom: 1.5rem;
  }
  .plan-features li { padding: 0.4rem 0; font-size: 0.9rem; color: var(--text-muted); border-bottom: 1px solid var(--glass-border); }
  .plan-features li:last-child { border-bottom: none; }

  .btn-plan {
    display: block;
    text-align: center;
    padding: 0.75rem;
    border-radius: 50px;
    text-decoration: none;
    font-size: 0.95rem;
    border: 1px solid var(--green);
    color: var(--green-light);
    transition: all 0.2s;
  }
  .btn-plan:hover, .featured-btn {
    background: linear-gradient(135deg, var(--green), var(--green-light));
    color: white;
    border-color: transparent;
  }
  .featured-btn { background: linear-gradient(135deg, var(--green), var(--green-light)); color: white; }

  /* FAQ */
  .faq { background: var(--bg); }
  .faq-list { max-width: 700px; margin: 3rem auto 0; display: flex; flex-direction: column; gap: 1rem; }
  .faq-item { border-radius: 12px; overflow: hidden; }
  .faq-q {
    width: 100%;
    background: none;
    border: none;
    color: var(--white);
    text-align: right;
    padding: 1.25rem 1.5rem;
    font-size: 1rem;
    cursor: pointer;
    font-family: inherit;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faq-q::after { content: '﹢'; color: var(--green-light); font-size: 1.2rem; }
  .faq-q.open::after { content: '﹣'; }
  .faq-a {
    display: none;
    padding: 0 1.5rem 1.25rem;
    color: var(--text-muted);
    line-height: 1.8;
    font-size: 0.95rem;
  }
  .faq-a.open { display: block; }

  /* Contact */
  .contact { background: var(--bg2); }
  .contact-cards { display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap; margin-top: 3rem; }
  .contact-card {
    border-radius: 16px;
    padding: 2rem 3rem;
    text-align: center;
    text-decoration: none;
    transition: transform 0.2s;
    min-width: 200px;
  }
  .contact-card:hover { transform: translateY(-4px); }
  .contact-icon { font-size: 2.5rem; margin-bottom: 0.75rem; }
  .contact-label { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.25rem; }
  .contact-val { color: var(--white); font-size: 1rem; font-weight: bold; }

  /* Footer */
  .footer { background: var(--bg); text-align: center; padding: 2rem; color: var(--text-muted); font-size: 0.85rem; border-top: 1px solid var(--glass-border); }

  /* Animations */
  .fade-in { animation: fadeIn 1s ease forwards; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }

  .reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.7s ease, transform 0.7s ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        setTimeout(() => entry.target.classList.add('visible'), i * 80);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  document.querySelectorAll('.faq-q').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.classList.toggle('open');
      btn.nextElementSibling.classList.toggle('open');
    });
  });
</script>
