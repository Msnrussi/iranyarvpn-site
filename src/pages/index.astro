<style is:global>

*{margin:0;padding:0;box-sizing:border-box}
:root{
  --green:#1a1a1a;--green-light:#ffffff;
  --bg:#000000;--text:#ffffff;--muted:#b5b5b5;
  --glass:rgba(255,255,255,0.05);--glass-border:rgba(255,255,255,0.16);
}
html{scroll-behavior:smooth}
html{background:#000 !important}body{font-family:'Vazirmatn',sans-serif;direction:rtl;background:#000 !important;color:#fff;overflow-x:hidden;position:relative}

/* near-black bg; SHARP vivid orbs (only soft edges, not blurred away) */
.bg-wrap{position:absolute;inset:0;z-index:0;overflow:hidden;pointer-events:none}
/* low blur => orbs stay crisp like the reference */
.orb{position:absolute;border-radius:50%;filter:blur(2px);will-change:transform;opacity:1}
/* solid vivid spheres with bright highlight, dark edge */
.o1{width:200px;height:200px;background:radial-gradient(circle at 35% 32%,#c77dff 0%,#a855f7 35%,#7c1fd6 70%,#5b16a0 100%);top:12%;right:14%}
.o2{width:150px;height:150px;background:radial-gradient(circle at 38% 35%,#ff7a5c 0%,#ff4d4d 40%,#e02d2d 75%,#b01f1f 100%);top:22%;left:12%}
.o3{width:230px;height:230px;background:radial-gradient(circle at 35% 32%,#6ba6ff 0%,#3b82f6 38%,#1e40af 72%,#142e8a 100%);top:34%;right:-40px}
.o4{width:210px;height:210px;background:radial-gradient(circle at 35% 32%,#5fce6f 0%,#3fa050 38%,#1d6b34 72%,#13501f 100%);top:58%;left:-30px}
.o5{width:160px;height:160px;background:radial-gradient(circle at 38% 35%,#ff6bb0 0%,#ff2d6b 40%,#c01250 75%,#900d3c 100%);top:70%;right:16%}
.o6{width:200px;height:200px;background:radial-gradient(circle at 35% 32%,#c77dff 0%,#a855f7 38%,#7c1fd6 72%,#5b16a0 100%);top:88%;left:14%}
.o7{width:180px;height:180px;background:radial-gradient(circle at 35% 32%,#6ba6ff 0%,#3b82f6 38%,#1e40af 72%,#142e8a 100%);top:122%;right:12%}
.o8{width:220px;height:220px;background:radial-gradient(circle at 38% 35%,#ff7a5c 0%,#ff4d4d 40%,#e02d2d 75%,#b01f1f 100%);top:140%;left:-30px}
.o9{width:170px;height:170px;background:radial-gradient(circle at 35% 32%,#5fce6f 0%,#3fa050 38%,#1d6b34 72%,#13501f 100%);top:158%;right:18%}

@keyframes drift{0%,100%{transform:translate(0,0)}50%{transform:translate(22px,-26px)}}

nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;justify-content:space-between;align-items:center;
  padding:0.9rem 1.5rem;margin:0.8rem;border-radius:18px;
  background:rgba(0,0,0,0.5);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);border:1px solid var(--glass-border)}
.nav-logo{display:flex;align-items:center;gap:0.6rem;font-weight:700;font-size:1.05rem}
.nav-logo img{width:34px;height:34px}
.nav-cta{background:#fff;color:#000;padding:0.5rem 1.3rem;border-radius:50px;text-decoration:none;font-size:0.88rem;font-weight:500;transition:.2s}
.nav-cta:hover{background:#ddd;transform:translateY(-1px)}

section{position:relative;z-index:2;min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:6rem 1.5rem 3rem;position:relative}

.hero{text-align:center}
.hero-logo{width:120px;height:120px;margin-bottom:1.5rem;animation:floaty 5s ease-in-out infinite;filter:drop-shadow(0 0 24px rgba(255,255,255,0.25))}
@keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
h1{font-size:clamp(2.4rem,7vw,4.8rem);font-weight:900;line-height:1.3;margin-bottom:1.2rem}
.grad{color:#ffffff}
.hero p{font-size:1.1rem;color:var(--muted);line-height:2;max-width:560px;margin:0 auto 2.5rem}
.btns{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}
.btn-primary{background:#ffffff;color:#000;padding:0.9rem 2.6rem;border-radius:50px;text-decoration:none;font-weight:700;box-shadow:0 6px 28px rgba(255,255,255,0.18);transition:.25s}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 10px 36px rgba(255,255,255,0.3)}
.btn-ghost{background:transparent;color:var(--text);padding:0.9rem 2.6rem;border-radius:50px;text-decoration:none;border:1px solid var(--glass-border);transition:.2s}
.btn-ghost:hover{background:var(--glass)}

/* frosted glass — blurs the vivid orbs behind it, exact reference shadow */
.glass-card{background:var(--glass);backdrop-filter:blur(24px) saturate(1.2);-webkit-backdrop-filter:blur(24px) saturate(1.2);
  border:1px solid var(--glass-border);border-radius:24px;box-shadow:0 1px 24px -1px rgba(0,0,0,0.1)}/* ref shadow applied */

.section-title{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:800;margin-bottom:0.6rem;text-align:center}
.section-sub{color:var(--muted);text-align:center;margin-bottom:3rem}
.container{max-width:1080px;width:100%;margin:0 auto}

.features-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:1.4rem}
.feature{padding:1.8rem;transition:.3s}
.feature:hover{transform:translateY(-6px);border-color:#fff}
.feature .ic{font-size:2.1rem;margin-bottom:0.9rem}
.feature h3{font-size:1.1rem;margin-bottom:0.5rem}
.feature p{color:var(--muted);font-size:0.92rem;line-height:1.9}

.pricing-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1.4rem}
.price-card{padding:2.2rem;text-align:center;position:relative;transition:.3s}
.price-card:hover{transform:translateY(-6px)}
.price-card.feat{border-color:#fff;box-shadow:0 0 50px rgba(255,255,255,0.15)}
.badge{position:absolute;top:-13px;left:50%;transform:translateX(-50%);background:#fff;color:#000;font-size:0.72rem;padding:5px 18px;border-radius:50px}
.p-name{color:var(--muted);margin-bottom:0.8rem}
.p-price{font-size:2.6rem;font-weight:900;margin-bottom:0.3rem}
.p-price span{font-size:0.95rem;color:var(--muted);font-weight:400}
.p-list{list-style:none;text-align:right;margin:1.5rem 0}
.p-list li{padding:0.5rem 0;font-size:0.9rem;color:var(--muted);border-bottom:1px solid var(--glass-border)}
.p-list li:last-child{border:none}
.p-btn{display:block;padding:0.8rem;border-radius:50px;text-decoration:none;border:1px solid #fff;color:#fff;transition:.2s;font-weight:600}
.p-btn:hover,.p-btn.feat{background:#fff;color:#000;border-color:transparent}

.reveal{opacity:0;transform:translateY(45px);transition:opacity .8s ease,transform .8s ease}
.reveal.vis{opacity:1;transform:translateY(0)}

footer{position:relative;z-index:2;text-align:center;padding:2.5rem;color:var(--muted);font-size:0.85rem;border-top:1px solid var(--glass-border);min-height:auto;position:relative}
.scroll-hint{position:absolute;bottom:2rem;left:50%;transform:translateX(-50%);width:7px;height:7px;border-radius:50%;background:#fff;animation:bob 2s infinite}
@keyframes bob{0%,100%{transform:translate(-50%,0);opacity:1}50%{transform:translate(-50%,12px);opacity:.4}}

</style>

<script is:inline>

const movers=[...document.querySelectorAll('[data-speed]')];
let ticking=false;
window.addEventListener('scroll',()=>{
  if(!ticking){
    requestAnimationFrame(()=>{
      const y=window.scrollY;
      movers.forEach(b=>{const s=parseFloat(b.dataset.speed);b.style.marginTop=(-y*s)+'px';});
      ticking=false;
    });
    ticking=true;
  }
});
const obs=new IntersectionObserver((es)=>{es.forEach((e,i)=>{if(e.isIntersecting){setTimeout(()=>e.target.classList.add('vis'),i*90);}});},{threshold:0.12});
document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));

</script>
