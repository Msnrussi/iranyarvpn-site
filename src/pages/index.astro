<style is:global>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#0a0a12;--bg2:#0d0d18;--surface:rgba(255,255,255,0.04);--border:rgba(255,255,255,0.09);
  --text:#f2f3f7;--muted:#9aa0b5;
  --green:#3fa050;--green-light:#5fce6f;--violet:#7c3aed;--violet-light:#a855f7;
}
html{scroll-behavior:smooth}
body{font-family:'Vazirmatn',sans-serif;direction:rtl;background:var(--bg);color:var(--text);overflow-x:hidden;line-height:1.7}
a{text-decoration:none;color:inherit}

/* ambient bg */
.bg-grid{position:fixed;inset:0;z-index:-2;background-image:linear-gradient(rgba(255,255,255,0.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.025) 1px,transparent 1px);background-size:54px 54px;mask-image:radial-gradient(ellipse 80% 60% at 50% 0%,#000 40%,transparent 100%)}
.bg-glow{position:fixed;border-radius:50%;filter:blur(120px);z-index:-1;opacity:0.5}
.g1{width:500px;height:500px;background:#7c3aed;top:-150px;right:-100px}
.g2{width:480px;height:480px;background:#1d6b34;top:40%;left:-150px}

/* nav */
.nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:0.8rem 1rem}
.nav-inner{max-width:1140px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:1rem;
  background:rgba(10,10,18,0.6);backdrop-filter:blur(18px);border:1px solid var(--border);border-radius:16px;padding:0.6rem 1.1rem}
.brand{display:flex;align-items:center;gap:0.55rem;font-weight:900;font-size:1.05rem}
.brand img{width:32px;height:32px}
.nav-links{display:flex;gap:1.6rem;font-size:0.9rem;color:var(--muted)}
.nav-links a:hover{color:var(--text)}
.nav-cta{background:linear-gradient(135deg,var(--violet),var(--violet-light));color:#fff;padding:0.5rem 1.3rem;border-radius:50px;font-size:0.88rem;font-weight:700;transition:.2s}
.nav-cta:hover{transform:translateY(-1px);box-shadow:0 8px 24px rgba(124,58,237,0.4)}

/* hero */
.hero{max-width:900px;margin:0 auto;padding:9rem 1.2rem 3rem;text-align:center}
.eyebrow{display:inline-block;font-size:0.82rem;color:var(--violet-light);background:rgba(124,58,237,0.12);border:1px solid rgba(124,58,237,0.25);padding:0.35rem 1rem;border-radius:50px;margin-bottom:1.5rem}
.hero h1{font-size:clamp(2.6rem,7vw,5rem);font-weight:900;line-height:1.25;letter-spacing:-0.02em}
.grad{background:linear-gradient(120deg,var(--green-light),var(--violet-light));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.lead{font-size:1.15rem;color:var(--muted);max-width:620px;margin:1.5rem auto 2.5rem}
.hero-cta{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}
.btn-primary{background:linear-gradient(135deg,var(--green),var(--green-light));color:#06210d;font-weight:800;padding:0.9rem 2.4rem;border-radius:50px;transition:.25s}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(63,160,80,0.4)}
.btn-primary.lg{padding:1.1rem 3rem;font-size:1.1rem}
.btn-ghost{padding:0.9rem 2.4rem;border-radius:50px;border:1px solid var(--border);color:var(--text);transition:.2s}
.btn-ghost:hover{background:var(--surface)}

/* ticker */
.ticker{margin-top:3.5rem;overflow:hidden;mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
.ticker-track{display:flex;gap:1rem;width:max-content;animation:scroll 28s linear infinite}
.ticker-track span{white-space:nowrap;background:var(--surface);border:1px solid var(--border);border-radius:50px;padding:0.5rem 1.2rem;font-size:0.9rem;color:var(--muted)}
@keyframes scroll{to{transform:translateX(50%)}}

/* sections */
section{max-width:1140px;margin:0 auto;padding:5rem 1.2rem}
.section-head{text-align:center;margin-bottom:3rem}
.section-head h2{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:900;letter-spacing:-0.01em;margin-top:0.5rem}
.section-head .sub{color:var(--muted);margin-top:0.5rem}

/* stats */
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2rem}
.stat{background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:2rem 1rem;text-align:center}
.stat-num{font-size:clamp(2rem,4vw,3rem);font-weight:900;background:linear-gradient(120deg,var(--green-light),var(--violet-light));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.stat-label{color:var(--muted);font-size:0.92rem;margin-top:0.3rem}

/* chart */
.chartsec{padding-top:1rem}
.chart-card{background:var(--surface);border:1px solid var(--border);border-radius:22px;padding:1.8rem}
.chart-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1.5rem}
.chart-head h3{font-size:1.15rem;font-weight:700;margin-top:0.3rem}
.chart-badge{color:var(--green-light);font-size:0.82rem;background:rgba(63,160,80,0.12);padding:0.3rem 0.9rem;border-radius:50px}
.chart{width:100%;height:240px;display:block}
.chart .line{stroke-dasharray:1600;stroke-dashoffset:1600;animation:draw 2.2s ease forwards}
.chart.in .line{stroke-dashoffset:0}
.chart .area{opacity:0;transition:opacity 1s ease 0.6s}
.chart.in .area{opacity:1}
@keyframes draw{to{stroke-dashoffset:0}}
.chart-x{display:flex;justify-content:space-between;margin-top:0.8rem;color:var(--muted);font-size:0.78rem}

/* features */
.feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}
.feat{background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:1.8rem;transition:.3s}
.feat:hover{transform:translateY(-5px);border-color:rgba(124,58,237,0.4)}
.feat-ic{font-size:1.9rem;margin-bottom:0.9rem}
.feat h3{font-size:1.1rem;font-weight:700;margin-bottom:0.4rem}
.feat p{color:var(--muted);font-size:0.92rem}

/* pricing */
.price-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem;align-items:start}
.price-card{background:var(--surface);border:1px solid var(--border);border-radius:22px;padding:2.2rem;text-align:center;position:relative;transition:.3s}
.price-card:hover{transform:translateY(-5px)}
.feat-card{border-color:rgba(124,58,237,0.5);box-shadow:0 0 60px rgba(124,58,237,0.15)}
.pc-badge{position:absolute;top:-13px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,var(--violet),var(--violet-light));color:#fff;font-size:0.72rem;font-weight:700;padding:5px 16px;border-radius:50px;white-space:nowrap}
.pc-name{color:var(--muted);margin-bottom:0.6rem}
.pc-price{font-size:2.4rem;font-weight:900}
.pc-price span{font-size:0.9rem;color:var(--muted);font-weight:400}
.price-card ul{list-style:none;margin:1.4rem 0;text-align:right}
.price-card li{padding:0.5rem 0;color:var(--muted);font-size:0.92rem;border-bottom:1px solid var(--border);position:relative;padding-right:1.5rem}
.price-card li:before{content:'✓';position:absolute;right:0;color:var(--green-light);font-weight:700}
.price-card li:last-child{border:none}
.pc-btn{display:block;padding:0.85rem;border-radius:50px;border:1px solid var(--border);color:var(--text);font-weight:700;transition:.2s}
.pc-btn:hover{background:var(--surface)}
.pc-btn-primary{background:linear-gradient(135deg,var(--violet),var(--violet-light));border-color:transparent;color:#fff}
.pc-btn-primary:hover{transform:translateY(-1px);box-shadow:0 8px 24px rgba(124,58,237,0.4)}

/* testimonials */
.testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}
.t-card{background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:1.8rem}
.t-card p{font-size:1rem;margin-bottom:1.2rem}
.t-author{display:flex;align-items:center;gap:0.6rem;color:var(--muted);font-size:0.9rem}
.t-av{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--violet),var(--green));color:#fff;font-weight:700}

/* faq */
.faq{max-width:760px}
.faq-list{display:flex;flex-direction:column;gap:0.9rem}
.faq-item{background:var(--surface);border:1px solid var(--border);border-radius:14px;overflow:hidden}
.faq-q{width:100%;background:none;border:none;color:var(--text);font-family:inherit;font-size:1rem;text-align:right;padding:1.2rem 1.4rem;cursor:pointer;display:flex;justify-content:space-between;align-items:center}
.faq-q i{color:var(--violet-light);font-style:normal;font-size:1.3rem;transition:.2s}
.faq-q.open i{transform:rotate(45deg)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease,padding .3s ease;color:var(--muted);padding:0 1.4rem}
.faq-a.open{max-height:200px;padding:0 1.4rem 1.2rem}

/* cta */
.cta{text-align:center;background:linear-gradient(135deg,rgba(124,58,237,0.12),rgba(63,160,80,0.1));border:1px solid var(--border);border-radius:28px;margin-top:2rem;margin-bottom:3rem}
.cta h2{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:900}
.cta p{color:var(--muted);margin:0.8rem 0 2rem}

/* footer */
.footer{border-top:1px solid var(--border);padding:3rem 1.2rem 2rem;max-width:1140px;margin:0 auto}
.foot-top{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1.5rem;margin-bottom:2rem}
.foot-brand{display:flex;align-items:center;gap:0.6rem;font-weight:900}
.foot-brand img{width:30px;height:30px}
.foot-links{display:flex;gap:1.6rem;color:var(--muted);font-size:0.92rem}
.foot-links a:hover{color:var(--text)}
.foot-bottom{color:var(--muted);font-size:0.85rem;text-align:center;padding-top:1.5rem;border-top:1px solid var(--border)}

/* reveal */
.reveal{opacity:0;transform:translateY(34px);transition:opacity .7s ease,transform .7s ease}
.reveal.in{opacity:1;transform:translateY(0)}

@media(max-width:860px){
  .nav-links{display:none}
  .stat-grid,.feat-grid,.price-grid,.testi-grid{grid-template-columns:1fr}
  .stat-grid{grid-template-columns:repeat(2,1fr)}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}}

/* intro */
.intro{padding-top:1rem;padding-bottom:1rem}
.intro-card{background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:2rem;max-width:820px;margin:0 auto;text-align:center;color:var(--muted);font-size:1.02rem}

/* security */
.security{max-width:820px;text-align:center}
.security .eyebrow{margin-bottom:1rem}
.security h2{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:900;margin-bottom:1rem}
.security p{color:var(--muted);font-size:1.05rem}

</style>

<script is:inline>

const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('in')})},{threshold:0.12});
document.querySelectorAll('.stat,.feat,.price-card,.t-card,.section-head,.chart-card,.cta,.intro-card,.security').forEach(el=>{el.classList.add('reveal');io.observe(el)});
const chart=document.querySelector('.chart');
if(chart){new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting)chart.classList.add('in')})},{threshold:0.3}).observe(chart);}
function fa(n){return n.toLocaleString('fa-IR')}
const cio=new IntersectionObserver((es)=>{es.forEach(e=>{
  if(!e.isIntersecting)return;
  const el=e.target, to=+el.dataset.to, suf=el.dataset.suffix||'';
  let cur=0; const step=Math.max(1,Math.floor(to/60));
  const t=setInterval(()=>{cur+=step; if(cur>=to){cur=to;clearInterval(t)} el.textContent=fa(cur)+suf;},22);
  cio.unobserve(el);
})},{threshold:0.5});
document.querySelectorAll('.stat-num').forEach(c=>cio.observe(c));
document.querySelectorAll('.faq-q').forEach(b=>{b.addEventListener('click',()=>{b.classList.toggle('open');b.nextElementSibling.classList.toggle('open')})});

</script>
